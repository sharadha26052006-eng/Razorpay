# Get a key at https://aistudio.google.com/apikey — used by the backend only, never sent to the browser.
GEMINI_API_KEY=
# Primary model. Defaults to Google's rolling alias "gemini-flash-latest" if unset.
GEMINI_MODEL=gemini-flash-latest
# Optional fallback, used when the primary model is overloaded, unavailable, or out of daily quota.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Optional locally (default 3001). Render sets PORT automatically.
PORT=3001
